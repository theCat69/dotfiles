{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@slkiser/opencode-quota",
    "@mohak34/opencode-notifier@latest"
  ],
  "mcp": {
    "youtube-transcript": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@thecat69/youtube-transcript-mcp"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN={env:GITHUB_TOKEN}",
        "-e",
        "GITHUB_TOOLSETS=repos,code_security,dependabot,security_advisories,actions",
        "-e",
        "GITHUB_READ_ONLY=true",
        "ghcr.io/github/github-mcp-server"
      ],
      "enabled": true
    },
    "headroom": {
      "type": "local",
      "command": [
        "/home/fefou/.local/share/../bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    }
  },
  "permission": {
    "context7_*": "deny",
    "youtube-transcript_*": "deny",
    "github_*": "deny"
  },
  "agent": {
    "build": {
      "permission": {
        "context7_*": "allow",
        "youtube-transcript_*": "allow",
        "github_*": "allow"
      }
    },
    "plan": {
      "permission": {
        "context7_*": "allow",
        "youtube-transcript_*": "allow",
        "github_*": "allow"
      }
    }
  },
  "lsp": {
    "jdtls": {
      "disabled": true
    },
    "jdtls-lombok": {
      "command": [
        "{env:HOME}/.local/share/opencode/bin/jdtls/bin/jdtls",
        "--jvm-arg=-javaagent:{env:HOME}/dev-tools/jars/lombok.jar",
        "-configuration",
        "{env:HOME}/.local/share/opencode/bin/jdtls/config_linux",
        "-data",
        "/tmp/opencode-jdtls-data"
      ],
      "extensions": [
        ".java"
      ]
    }
  },
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  }
}
